{
  "title": "Existenz.ch Data APIs Metadata",
  "description": "Locations and parameters for SwissMetNet (MeteoSwiss) and Hydrodaten (BAFU/FOEN), along with Existenz.ch custom sensors",
  "source": "api.existenz.ch",
  "source_url": "https://api.existenz.ch/",
  "plugins": {
    "datasette-cluster-map": {
      "latitude_column": "lat",
      "longitude_column": "lon"
    },
    "datasette-ip-rate-limit": {
      "debug": false,
      "rules": [
        {
          "paths": ["/*"],
          "block_seconds": 360,
          "window_seconds": 60,
          "max_requests": 15,
          "query_params_min": 1
        }
      ]
    }
  }
}
